# AutomationCapture: copy this file to .env and edit it for your environment.
# Keep .env private. Empty secrets must be supplied before using their features.
#
# Claude discovery. The key is required only for the discovery command.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=30

# Browser and navigation. Change domains and the reviewed allowlist together.
BROWSER_DRIVER=chrome
SELENIUM_HEADLESS=true
SELENIUM_TIMEOUT=10000
LOCATOR_TIMEOUT_SECONDS=10
ACTION_WAIT_TIMEOUT_SECONDS=10
ALLOWED_DOMAINS=localhost:5000,127.0.0.1:5000
# Set to config/target_app.allowlist.json for the full local demo.
ALLOWLIST_PATH=config/allowlist.json
ALLOWLIST_MODE=production
ENVIRONMENT=development
# Testing bypass only: enable development mode and set matching tokens explicitly.
# ALLOWLIST_BYPASS_TOKEN=
# ALLOWLIST_BYPASS_PRESENTED_TOKEN=

# Privacy and audit. NONE redaction is available only in development mode.
REDACTION_LEVEL=STRICT
EVIDENCE_CAPTURE_LEVEL=ERRORS
RISK_APPROVAL_REQUIRED=CRITICAL
LOG_LEVEL=INFO
STRUCTURED_LOG_LEVEL=INFO
STRUCTURED_LOG_MAX_FIELD_CHARS=512
# Optional JSON arrays for extra field names and regex patterns.
# REDACTION_FIELDS='["member_id","account_id","amount","ssn","email"]'
# REDACTION_PATTERNS='["\\b\\d{3}-\\d{2}-\\d{4}\\b"]'
LOG_DIRECTORY=evidence/logs
EVIDENCE_DIRECTORY=evidence/capture
RAW_EVIDENCE_DIRECTORY=evidence/escalations/raw
ESCALATION_DIRECTORY=evidence/escalations
HANDOFF_DIRECTORY=evidence/handoffs
SESSION_DIRECTORY=evidence/sessions
SESSION_RETENTION_DAYS=30
ESCALATION_ELEMENT_LIMIT=20

# CLI and replay limits.
ARTIFACT_DIRECTORY=artifacts
MAX_REPLAY_STEPS=100
REPLAY_TIMEOUT_SECONDS=300
REPLAY_MAX_RECOVERY_RETRIES=1
ERROR_DETECTION_TIMEOUT_SECONDS=0.25
LOCATOR_POLL_INTERVAL_SECONDS=0.05
CHECKPOINT_POLL_INTERVAL_SECONDS=0.05
CHECKPOINT_CASE_SENSITIVE=true
CHECKPOINT_URL_MATCH_MODE=auto
CHECKPOINT_PAGE_TEXT_CHARS=512

# Discovery observations and artifact recording.
OBSERVATION_MAX_CHARS=12000
OBSERVATION_NODE_LIMIT=300
RECORDER_PARAMETER_SCAN_LIMIT=8
ARTIFACT_STEP_TIMEOUT_MS=10000
ARTIFACT_INITIAL_VERSION=1.0.0
ARTIFACT_CREATED_BY=automation-capture/agent

# Risk policy. Override with valid JSON objects if needed.
RISK_LOCATOR_KEYWORDS='{"confirm":1,"delete":2,"permanently":2,"close_account":3,"transfer":2,"final":1}'
RISK_REASONING_KEYWORDS='{"confirm":1,"irreversible":2,"delete":2,"close":2,"transfer":2,"permanent":2,"final":1}'
RISK_FAILURE_THRESHOLD=3
RISK_WRITE_STREAK=2
RISK_EARLY_STEP_LIMIT=2
RISK_LATE_STEP_START=50

# Stuck-state and escalation limits.
STUCK_SIGNATURE_TEXT_CHARS=500
STUCK_STATE_THRESHOLD=3
STUCK_HISTORY_LIMIT=20
STUCK_CONTEXT_STEPS=5
STUCK_RISKY_KEYWORDS=delete,close,transfer,remove,unsubscribe
STUCK_VISIBLE_ELEMENTS_LIMIT=20
STUCK_VISIBLE_TEXT_CHARS=120
STUCK_VISIBLE_SELECTOR=button,input,select,textarea,a,[role=button]

# Local Flask demo only. Generate FLASK_SECRET_KEY with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=
TARGET_APP_CONFIG_PATH=config/target_app.example.json
TARGET_APP_HOST=127.0.0.1
TARGET_APP_PORT=5000
